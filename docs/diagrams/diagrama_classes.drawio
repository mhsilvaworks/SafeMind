                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    %% Enums\n    class TipoConta {\n        &lt;&lt;enumeration&gt;&gt;\n        Neurodivergente\n        Profissional\n        Empresa\n    }\n\n    class StatusLaudo {\n        &lt;&lt;enumeration&gt;&gt;\n        Pendente\n        Verificado\n        Rejeitado\n    }\n\n    class TipoForum {\n        &lt;&lt;enumeration&gt;&gt;\n        B2CPublico\n        B2BTerapeutico\n    }\n\n    class TipoDocumento {\n        &lt;&lt;enumeration&gt;&gt;\n        LaudoMedico\n        CRM\n        CRP\n        CNPJ\n    }\n\n    %% Classe Base\n    class User {\n        +Guid Id\n        +String Nome\n        +String Email\n        +String SenhaHash\n        +DateTime DataNascimento\n        +TipoConta TipoConta\n        +StatusLaudo StatusLaudo\n    }\n\n    %% Classes Herdeiras (Herança)\n    class Neurodivergente {\n        +String Diagnostico\n        +List~String~ Interesses\n        +Boolean IsModoBaixaBateriaSocial\n    }\n\n    class Especialista {\n        +String RegistroProfissional\n        +String Especialidade\n    }\n\n    class Empresa {\n        +String CNPJ\n        +String NomeFantasia\n    }\n\n    %% Entidades de Conteúdo\n    class Forum {\n        +Guid Id\n        +String Titulo\n        +String Descricao\n        +Guid OwnerId\n        +TipoForum TipoForum\n        +Int IdadeMinima\n        +Boolean RequerLaudo\n    }\n\n    class Post {\n        +Guid Id\n        +String Conteudo\n        +Guid UserId\n        +Guid ForumId\n        +Boolean HasTriggerWarning\n    }\n\n    class ValidationDocument {\n        +Guid Id\n        +Guid UserId\n        +TipoDocumento TipoDocumento\n        +String UrlDocumento\n        +DateTime DataEnvio\n    }\n\n    %% Relacionamentos de Herança\n    User &lt;|-- Neurodivergente\n    User &lt;|-- Especialista\n    User &lt;|-- Empresa\n\n    %% Relacionamentos de Associação\n    User \&quot;1\&quot; --&gt; \&quot;1\&quot; ValidationDocument : submete\n    User \&quot;1\&quot; --&gt; \&quot;*\&quot; Post : faz\n    Forum \&quot;1\&quot; --&gt; \&quot;*\&quot; Post : contém\n    \n    %% Relacionamentos Específicos\n    Especialista \&quot;1\&quot; --&gt; \&quot;*\&quot; Forum : gerencia (B2B Terapêutico)\n    Empresa \&quot;1\&quot; --&gt; \&quot;*\&quot; Forum : gerencia (B2B Institucional)&quot;&#xa;}" id="4">
