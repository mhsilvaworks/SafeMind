        <mxGraphModel dx="4983" dy="3893" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    %% Enums\n    class TipoConta {\n        &lt;&lt;enumeration&gt;&gt;\n        Neurodivergente\n        Profissional\n        Empresa\n        Administrador\n    }\n\n    class StatusLaudo {\n        &lt;&lt;enumeration&gt;&gt;\n        Pendente\n        Verificado\n        Rejeitado\n    }\n\n    class TipoForum {\n        &lt;&lt;enumeration&gt;&gt;\n        B2CPublico\n        B2BTerapeutico\n    }\n\n    class TipoDocumento {\n        &lt;&lt;enumeration&gt;&gt;\n        LaudoMedico\n        CRM\n        CRP\n        CNPJ\n    }\n\n    %% Classe Base\n    class User {\n        +Guid Id\n        +String Nome\n        +String Email\n        +String PasswordHash\n        +DateTime BirthDate\n        +TipoConta AccountType\n    }\n\n    %% Subclasses de User\n    class UsuarioNeurodivergente {\n        +StatusLaudo ValidationStatus\n        +Boolean IsLowSpoonMode\n    }\n\n    class Profissional {\n        +String Cpf\n        +StatusLaudo ValidationStatus\n    }\n\n    class Empresa {\n        +String Cnpj\n        +StatusLaudo ValidationStatus\n    }\n\n    class Administrador {\n        +String NivelAcesso\n        +String Departamento\n    }\n\n    %% Entidades Relacionadas\n    class ValidationDocument {\n        +Guid Id\n        +TipoDocumento DocumentType\n        +String FileUrl\n        +DateTime DataEnvio\n    }\n\n    class Forum {\n        +Guid Id\n        +String Title\n        +String Description\n        +TipoForum ForumType\n        +Guid OwnerId\n    }\n\n    class Post {\n        +Guid Id\n        +String Content\n        +DateTime CreatedAt\n        +Guid AuthorId\n        +Guid ForumId\n    }\n\n    %% DTOs\n    class RegisterUserDto {\n        +String Nome\n        +String Email\n        +String Password\n        +DateTime BirthDate\n        +TipoConta AccountType\n        +String CpfCnpj\n        +String UrlLaudo\n        +String UrlCertificadoProfissional\n    }\n\n    class LoginUserDto {\n        +String Email\n        +String Password\n    }\n\n    %% Interfaces\n    class IAuthService {\n        &lt;&lt;interface&gt;&gt;\n        +Register(dto: RegisterUserDto) String\n        +Login(dto: LoginUserDto) String\n    }\n\n    %% Services (Regras de Negócio)\n    class AuthService {\n        -_context AppDbContext\n        -_config IConfiguration\n        +AuthService(context: AppDbContext, config: IConfiguration)\n        +Register(dto: RegisterUserDto) String\n        +Login(dto: LoginUserDto) String\n    }\n\n    %% Relacionamentos de Herança\n    User &lt;|-- UsuarioNeurodivergente\n    User &lt;|-- Profissional\n    User &lt;|-- Empresa\n    User &lt;|-- Administrador\n\n    %% Relacionamentos de Composição/Associação\n    UsuarioNeurodivergente *-- ValidationDocument\n    Profissional *-- ValidationDocument\n    Forum *-- Post\n    User \&quot;1\&quot; -- \&quot;*\&quot; Post : writes\n    User \&quot;1\&quot; -- \&quot;*\&quot; Forum : owns\n\n    %% Relacionamentos de Dependência (Aplicação)\n    IAuthService &lt;|.. AuthService : implements\n    AuthService ..&gt; RegisterUserDto : uses\n    AuthService ..&gt; LoginUserDto : uses\n    AuthService ..&gt; User : creates/queries&quot;&#xa;}" id="8">
                    <mxCell style="shape=image;noLabel=1;verticalAlign=top;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1">
